{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystaworld",
  "main": "src/server/site.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  // Keep Workers Logs on so errors such as CPU limit hits stay searchable.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Prerendered pages and files are served straight from the asset layer.
    // Prerendering needs paths without a file to reach the Worker, so this stays "none" here.
    // The build switches the deployed config (dist/server/wrangler.json) to "404-page" after the
    // prerender step, see src/build/plugins/not-found-page. From then on unknown paths get
    // public/404.html with a 404 status and never start the Worker.
    "not_found_handling": "none",
    "run_worker_first": [
      "/admin",
      "/admin/",
      "/auth",
      "/callback",
      "/oauth/authorize",
      "/oauth/redirect",
      "/api/link-preview",
      "/_serverFn/*",
      "/cms-preview"
    ]
  }
}
