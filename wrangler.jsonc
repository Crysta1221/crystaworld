{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystaworld",
  "main": "workers/site.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth", "/callback", "/oauth/authorize", "/oauth/redirect"]
  }
}
